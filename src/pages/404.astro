---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Ecologik" description="This page doesn’t exist.">
  <main class="wrap flex flex-col items-start gap-8 py-[clamp(80px,12vw,180px)]">
    <h1 class="h-page">Page <span class="accent">not found.</span></h1>
    <p class="m-0 text-[20px] text-cream-2">The page you’re looking for has moved or doesn’t exist.</p>
    <a href="/" class="btn btn-green">Back to home</a>
  </main>
</Base>
