---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL('/images/kitchen.jpg', Astro.site ?? SITE.url).href;

// Business details for Google (LocalBusiness / Plumber structured data).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Plumber', 'HVACBusiness'],
  name: SITE.name,
  url: SITE.url,
  telephone: '+1-' + SITE.phone,
  email: SITE.email,
  image: ogImage,
  logo: new URL('/images/logo.png', Astro.site ?? SITE.url).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.street,
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    ...(SITE.postalCode ? { postalCode: SITE.postalCode } : {}),
    addressCountry: SITE.country,
  },
  areaServed: ['North Shore', 'Lower Mainland', 'British Columbia'],
  founder: { '@type': 'Person', name: 'Daniel Cintora' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="theme-color" content="#111411" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="pb-[60px] xl:pb-0">
    <Header />
    <slot />
    <Footer />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
